# PostgreSQL (postgres:16 container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dota_demo
# Host port to map the container's 5432 onto. Change if 5432 is in use.
POSTGRES_PORT=5432

# Connection string used by scripts/load_bronze.py and dbt.
# host is the container service name when loaded inside docker-compose,
# or localhost when run from the host.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dota_demo

# Memory profile. Keep 1GB on a 16GB host / 6GB Docker VM.
# scripts/db_profile.py raises work_mem/parallelism for a full refresh and
# reverts to the safe default afterwards.
PG_SHARED_BUFFERS=1GB
PG_MAX_CONNECTIONS=100

# dbt default (safe). run_pipeline.py temporarily raises this for full refresh.
DBT_THREADS=2

# Daily orchestrator scrape size (proMatches only).
DOTA_SCRAPE_LIMIT=100

# Database the CLI status panel reads (the PBIP model is switched separately).
DOTA_ACTIVE_DB=dota_demo
