# PostgreSQL (postgres:16 container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dota
# Host port to map the container's 5432 onto. Change if 5432 is in use.
POSTGRES_PORT=5432

# Connection string used by scripts/load_bronze.py and dbt.
# host is the container service name when loaded inside docker-compose,
# or localhost when run from the host.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dota