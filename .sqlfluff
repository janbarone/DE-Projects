[sqlfluff]
dialect = postgres
templater = dbt
max_line_length = 120
# Stylistic rules relaxed: the models predate sqlfluff's defaults and use a
# consistent (aligned-columns) style these rules would rewrite. We keep the
# correctness rules (parse errors, capitalization, identifier casing).
exclude_rules = L016, L031, LT01, LT02, LT08, LT09, LT12, LT14, RF02, RF04, RF06, AM05
# dbt target/ is generated output.
ignore_templated_areas = false

[sqlfluff:templater:dbt]
project_dir = transform
profiles_dir = .
profile = transform
target = dev

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.identifiers]
extended_capitalisation_policy = lower
