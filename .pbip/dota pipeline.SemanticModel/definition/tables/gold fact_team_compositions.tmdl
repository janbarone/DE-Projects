table 'gold fact_team_compositions'
	lineageTag: aaaa000a-0000-0000-0000-000000000001

	measure 'Comp Games' = COUNTROWS('gold fact_team_compositions')
		formatString: #,##0
		lineageTag: aaaa000a-0000-0000-0000-000000000010

	measure 'Comp Wins' = CALCULATE(COUNTROWS('gold fact_team_compositions'), 'gold fact_team_compositions'[team_win])
		formatString: #,##0
		lineageTag: aaaa000a-0000-0000-0000-000000000011

	measure 'Comp Win Rate' = DIVIDE([Comp Wins], [Comp Games])
		formatString: 0.0%
		lineageTag: aaaa000a-0000-0000-0000-000000000012

	column match_id
		dataType: string
		sourceProviderType: nvarchar(max)
