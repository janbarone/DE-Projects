	measure 'Total Dewards' = SUM('gold fact_match_players'[observer_kills]) + SUM('gold fact_match_players'[sentry_kills])
		formatString: #,##0
		lineageTag: aaaa0001-0000-0000-0000-0000000000c3

	measure 'Total Observer Wards Bought' = SUM('gold fact_match_players'[purchase_ward_observer])
