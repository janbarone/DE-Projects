table 'gold fact_match_players'
	lineageTag: 22233bf7-4af2-42a9-ae07-a875ea33ddb1

	measure 'Total Picks' = COUNTROWS('gold fact_match_players')
		formatString: #,##0
		lineageTag: 0ada0832-b3d0-42d0-85c5-e9651fdb89a4

	measure 'Total Player Wins' = CALCULATE(COUNTROWS('gold fact_match_players'), 'gold fact_match_players'[team_win])
		formatString: #,##0
		lineageTag: 3565ff0d-eb87-4e56-b14e-b5097c537ddd

	measure 'Player Win Rate' = DIVIDE([Total Player Wins], [Total Picks])
		formatString: 0.0%
		lineageTag: 1aa625b5-5cc4-4b73-9d61-3adfe6ca9743

	measure 'Avg KDA' = AVERAGE('gold fact_match_players'[kda])
		formatString: 0.00
		lineageTag: 12e0a4a3-b68c-43bf-940b-aaacf0ded3de

	measure 'Avg GPM' = AVERAGE('gold fact_match_players'[gold_per_min])
		formatString: 0
		lineageTag: b57d0088-11f6-42fb-a762-0015bff31603

	measure 'Avg XPM' = AVERAGE('gold fact_match_players'[xp_per_min])
		formatString: 0
		lineageTag: 6375f9b3-85d0-48fc-a478-aa2f4c2b7ba4

	measure 'Avg Hero Damage' = AVERAGE('gold fact_match_players'[hero_damage])
		formatString: #,##0
		lineageTag: dd5ac601-8905-4486-8bda-ac3b2a4b9764

	measure 'Avg Tower Damage' = AVERAGE('gold fact_match_players'[tower_damage])
		formatString: #,##0
		lineageTag: 72334928-16bd-49c3-bcb9-ac8d4f9a3b75

	measure 'Total Player Kills' = SUM('gold fact_match_players'[kills])
		formatString: #,##0
		lineageTag: 1a717c6a-97d6-4f33-972f-044bb3d85192

	measure 'Total Player Deaths' = SUM('gold fact_match_players'[deaths])
		formatString: #,##0
		lineageTag: 9148fb8b-d8bd-4466-ab3f-6142aa1d02c8

	measure 'Total Assists' = SUM('gold fact_match_players'[assists])
		formatString: #,##0
		lineageTag: c0a54edc-ea20-4465-8488-9cb799e0008a

	measure 'Avg Net Worth' = AVERAGE('gold fact_match_players'[net_worth])
		formatString: #,##0
		lineageTag: aaaa0001-0000-0000-0000-000000000001

	measure 'Avg Last Hits' = AVERAGE('gold fact_match_players'[last_hits])
		formatString: #,##0
		lineageTag: aaaa0001-0000-0000-0000-000000000002

	measure 'Avg Denies' = AVERAGE('gold fact_match_players'[denies])
		formatString: 0.00
		lineageTag: aaaa0001-0000-0000-0000-000000000003

	measure 'Avg Stuns (sec)' = AVERAGE('gold fact_match_players'[stuns])
		formatString: 0.00
		lineageTag: aaaa0001-0000-0000-0000-000000000004

	measure 'Avg Healing' = AVERAGE('gold fact_match_players'[hero_healing])
		formatString: #,##0
		lineageTag: aaaa0001-0000-0000-0000-000000000005

	measure 'Avg Camps Stacked' = AVERAGE('gold fact_match_players'[camps_stacked])
		formatString: 0.00
		lineageTag: aaaa0001-0000-0000-0000-000000000006

	measure 'Avg Rune Pickups' = AVERAGE('gold fact_match_players'[rune_pickups])
		formatString: 0.00
		lineageTag: aaaa0001-0000-0000-0000-000000000007

	measure 'Avg Buybacks' = AVERAGE('gold fact_match_players'[buyback_count])
		formatString: 0.00
		lineageTag: aaaa0001-0000-0000-0000-000000000008

	measure 'Total First Bloods' = SUM('gold fact_match_players'[firstblood_claimed])
		formatString: #,##0
		lineageTag: aaaa0001-0000-0000-0000-000000000009

	measure 'Total Randoms' = CALCULATE(COUNTROWS('gold fact_match_players'), 'gold fact_match_players'[randomed])
		formatString: #,##0
		lineageTag: aaaa0001-0000-0000-0000-00000000000a

	measure 'Leaver Picks' = CALCULATE(COUNTROWS('gold fact_match_players'), 'gold fact_match_players'[leaver_status] <> "0")
		formatString: #,##0
		lineageTag: aaaa0001-0000-0000-0000-00000000000b

	measure 'Team Gold Early' = MAX('gold fact_match_players'[gold_early])
		formatString: #,##0
		lineageTag: bbbb0001-0000-0000-0000-000000000040

	measure 'Team Gold Mid' = MAX('gold fact_match_players'[gold_mid])
		formatString: #,##0
		lineageTag: bbbb0001-0000-0000-0000-000000000041

	measure 'Team Gold Late' = MAX('gold fact_match_players'[gold_late])
