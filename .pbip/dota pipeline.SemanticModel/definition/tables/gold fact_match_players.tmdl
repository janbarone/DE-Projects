		lineageTag: bbbb0001-0000-0000-0000-000000000045

	measure 'Total Wards Placed' = SUM('gold fact_match_players'[obs_placed]) + SUM('gold fact_match_players'[sen_placed])
		formatString: #,##0
		lineageTag: aaaa0001-0000-0000-0000-0000000000c0

	measure 'Total Observer Wards Placed' = SUM('gold fact_match_players'[obs_placed])
		formatString: #,##0
