table 'gold fact_team_h2h'
	lineageTag: 548c7a28-6038-4e79-a8b9-a87ea099e55c

	measure 'H2H Games' = COUNTROWS('gold fact_team_h2h')
		formatString: #,##0
		lineageTag: ac94f6ea-3e4e-4817-b1f6-40dcb17722b1

	measure 'Team A Wins' = CALCULATE(COUNTROWS('gold fact_team_h2h'), 'gold fact_team_h2h'[team_a_win])
		formatString: #,##0
		lineageTag: 9b5b5e12-962b-4582-aeb9-3d54ab97ba18

	measure 'Team A Win Rate' = DIVIDE([Team A Wins], [H2H Games])
		formatString: 0.0%
		lineageTag: 6e48be43-3c37-4846-9611-1da715ec9142

