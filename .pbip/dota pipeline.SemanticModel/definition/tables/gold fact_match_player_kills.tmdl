table 'gold fact_match_player_kills'
	lineageTag: aaaa0103-0000-0000-0000-000000000000

	measure 'Hero Kills' = COUNTROWS('gold fact_match_player_kills')
		formatString: #,##0
		lineageTag: aaaa0103-0000-0000-0000-0000000000f0

	measure 'Hero Kills Radiant' = CALCULATE(COUNTROWS('gold fact_match_player_kills'), 'gold fact_match_player_kills'[side] = "Radiant")
		formatString: #,##0
		lineageTag: aaaa0103-0000-0000-0000-0000000000f1

	measure 'Hero Kills Dire' = CALCULATE(COUNTROWS('gold fact_match_player_kills'), 'gold fact_match_player_kills'[side] = "Dire")
		formatString: #,##0
		lineageTag: aaaa0103-0000-0000-0000-0000000000f2

