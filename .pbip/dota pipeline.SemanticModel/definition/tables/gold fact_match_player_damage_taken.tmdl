table 'gold fact_match_player_damage_taken'
	lineageTag: aaaa0106-0000-0000-0000-000000000000

	measure 'Total Damage Taken' = SUM('gold fact_match_player_damage_taken'[damage_amount])
		formatString: #,##0
		lineageTag: aaaa0106-0000-0000-0000-0000000000f0

	measure 'Total Building Damage Taken' = CALCULATE(SUM('gold fact_match_player_damage_taken'[damage_amount]), 'gold fact_match_player_damage_taken'[source_category] = "Building")
		formatString: #,##0
		lineageTag: aaaa0106-0000-0000-0000-0000000000f1

	measure 'Total Hero Damage Taken' = CALCULATE(SUM('gold fact_match_player_damage_taken'[damage_amount]), 'gold fact_match_player_damage_taken'[source_category] = "Hero")
		formatString: #,##0
		lineageTag: aaaa0106-0000-0000-0000-0000000000f2

