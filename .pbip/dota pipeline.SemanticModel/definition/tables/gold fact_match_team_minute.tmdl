table 'gold fact_match_team_minute'
	lineageTag: aaaa0108-0000-0000-0000-000000000000

	measure 'Team Gold' = MAX('gold fact_match_team_minute'[team_gold])
		formatString: #,##0
		lineageTag: aaaa0108-0000-0000-0000-0000000000f0

	measure 'Team XP' = MAX('gold fact_match_team_minute'[team_xp])
		formatString: #,##0
		lineageTag: aaaa0108-0000-0000-0000-0000000000f1

