		formatString: 0
		sourceProviderType: int
		lineageTag: dddd0001-0000-0000-0000-000000000009
		summarizeBy: sum
		sourceColumn: xp_delta

		annotation SummarizationSetBy = Automatic

	column deaths
		dataType: int64
		formatString: 0
		sourceProviderType: int
		lineageTag: dddd0001-0000-0000-0000-00000000000a
		summarizeBy: sum
		sourceColumn: deaths

		annotation SummarizationSetBy = Automatic

	column items_used
		dataType: string
		sourceProviderType: nvarchar(max)
		lineageTag: dddd0001-0000-0000-0000-00000000000b
		summarizeBy: none
		sourceColumn: items_used

		annotation SummarizationSetBy = Automatic

	column abilities_used
		dataType: string
		sourceProviderType: nvarchar(max)
		lineageTag: dddd0001-0000-0000-0000-00000000000c
		summarizeBy: none
		sourceColumn: abilities_used

		annotation SummarizationSetBy = Automatic

	column radiant_win
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		sourceProviderType: bit
		lineageTag: dddd0001-0000-0000-0000-00000000000d
		summarizeBy: none
		sourceColumn: radiant_win

		annotation SummarizationSetBy = Automatic

	partition 'gold fact_match_timeline' = m
		mode: directQuery
		source =
				let
				    Source = PostgreSQL.Database("localhost", "dota"),
				    gold_fact_match_timeline = Source{[Schema="gold",Item="fact_match_timeline"]}[Data]
				in
				    gold_fact_match_timeline

