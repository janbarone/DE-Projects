		lineageTag: aaaa010b-0000-0000-0000-0000000000f0

	measure 'Matchup Radiant Win Rate' = MAX('gold fact_hero_matchup_stats'[radiant_win_rate])
		formatString: 0.0%
		lineageTag: aaaa010b-0000-0000-0000-0000000000f1

	measure 'Matchup Dire Win Rate' = MAX('gold fact_hero_matchup_stats'[dire_win_rate])
		formatString: 0.0%
		lineageTag: aaaa010b-0000-0000-0000-0000000000f2

