            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "What this report is",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14pt",
                      "fontWeight": "600",
                      "color": "#1B4F72"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "A Power BI dashboard over professional Dota 2 matches fetched from the OpenDota API and modelled in a PostgreSQL 'gold' schema. It connects in DirectQuery, so every visual queries the live database.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9.5pt",
                      "fontWeight": "normal"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Data covers The International tournaments (2012-2025) plus pro matches scraped via /proMatches Ã¢â‚¬â€ all 4,299 downloaded match files.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9.5pt",
                      "fontWeight": "normal"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "What you can expect to see",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "fontWeight": "600"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "9 pages split by theme: Matches, Overview, Hero Meta, Players, Teams, Combat, Economy, Draft, and this About page. Each data page is a slice of the same match data, so slicers (year, league, region, patch, mode, lobby) and click-to-cross-filter work across visuals on a page.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9.5pt",
                      "fontWeight": "normal"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "How to use it",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "fontWeight": "600"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Start on Overview for the headline numbers. Use the slicers on any page to narrow the data. Click a bar, slice or table row to highlight the rest of the page. Numbers are computed from the matches themselves, so they respond to every filter.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9.5pt",
                      "fontWeight": "normal"
                    }
                  }
                ]
              }
            ]
